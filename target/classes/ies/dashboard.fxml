<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="ies.MainController" stylesheets="@styles.css" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="680.0" prefWidth="950.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label styleClass="titulo-principal" text="Gestión de Incidencias" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button onAction="#handleNuevaIncidencia" styleClass="button-primary" text="+ Nueva Incidencia" />
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <TextField fx:id="Buscar" promptText="Buscar incidencia por nombre o solicitante..." HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="FiltroEstado" />
            <ComboBox fx:id="FiltroPrioridad" />
         </children>
      </HBox>

      <Label text="Listado de Incidencias:" />

      <ListView fx:id="listViewIncidencias" prefHeight="340.0" />

      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <HBox spacing="12.0">
               <children>
                  <VBox styleClass="card-contador">
                     <padding><Insets bottom="10.0" left="18.0" right="18.0" top="10.0" /></padding>
                     <children>
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="TOTALES" />
                        <Label fx:id="TotalNum" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0" />
                     </children>
                  </VBox>
                  <VBox styleClass="card-contador">
                     <padding><Insets bottom="10.0" left="18.0" right="18.0" top="10.0" /></padding>
                     <children>
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #e11d48;" text="ABIERTAS" />
                        <Label fx:id="AbiertasNum" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0" />
                     </children>
                  </VBox>
                  <VBox styleClass="card-contador">
                     <padding><Insets bottom="10.0" left="18.0" right="18.0" top="10.0" /></padding>
                     <children>
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #d97706;" text="EN PROCESO" />
                        <Label fx:id="EnProcesoNum" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0" />
                     </children>
                  </VBox>
                  <VBox styleClass="card-contador">
                     <padding><Insets bottom="10.0" left="18.0" right="18.0" top="10.0" /></padding>
                     <children>
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #059669;" text="CERRADAS" />
                        <Label fx:id="CerradasNum" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <Pane HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <!-- Corregido: fx:id coincide exactamente con MainController.java -->
                  <Button fx:id="ModificarSeleccionada" onAction="#handleModificar" styleClass="button-primary" text="Modificar Seleccionada" />
                  <!-- Corregido: fx:id coincide exactamente con MainController.java -->
                  <Button fx:id="EliminarSeleccionada" onAction="#handleEliminar" styleClass="button-danger" text="Eliminar Seleccionada" />
               </children>
            </HBox>
         </children>
      </HBox>

      <Label fx:id="Feedback" maxWidth="1.7976931348623157E308" styleClass="label-feedback" text="  Mensaje de Feedback">
         <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
      </Label>
   </children>
</VBox>